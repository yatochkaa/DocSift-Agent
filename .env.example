DOCSIFT_APP_NAME=DocSift Agent
DOCSIFT_DATABASE_URL=postgresql+asyncpg://docsift:docsift-local@localhost:5432/docsift
DOCSIFT_STORAGE_PATH=var/uploads
DOCSIFT_MAX_UPLOAD_BYTES=20971520
DOCSIFT_UPLOAD_CHUNK_BYTES=1048576

# Основной LLM-профиль приложения
DOCSIFT_LLM_PROVIDER=ollama
DOCSIFT_LLM_BASE_URL=http://localhost:11434
DOCSIFT_LLM_API_KEY=
DOCSIFT_LLM_MODEL=qwen2.5:7b-instruct
DOCSIFT_LLM_NATIVE_STRUCTURED_OUTPUT=true
DOCSIFT_LLM_TIMEOUT_SECONDS=120
DOCSIFT_LLM_PROMPT_VERSION=v1

# Eval-профиль local: бесплатный локальный Ollama
DOCSIFT_EVAL_LOCAL_PROVIDER=ollama
DOCSIFT_EVAL_LOCAL_BASE_URL=http://localhost:11434
DOCSIFT_EVAL_LOCAL_API_KEY=
DOCSIFT_EVAL_LOCAL_MODEL=qwen2.5-coder:7b
DOCSIFT_EVAL_LOCAL_NATIVE_STRUCTURED_OUTPUT=true
DOCSIFT_EVAL_LOCAL_TIMEOUT_SECONDS=300
DOCSIFT_EVAL_LOCAL_INPUT_PRICE_PER_MILLION=0
DOCSIFT_EVAL_LOCAL_OUTPUT_PRICE_PER_MILLION=0

# Eval-профиль cloud: заполните параметры выбранного OpenAI-совместимого API
DOCSIFT_EVAL_CLOUD_PROVIDER=openai_compatible
DOCSIFT_EVAL_CLOUD_BASE_URL=
DOCSIFT_EVAL_CLOUD_API_KEY=
DOCSIFT_EVAL_CLOUD_MODEL=
DOCSIFT_EVAL_CLOUD_NATIVE_STRUCTURED_OUTPUT=true
DOCSIFT_EVAL_CLOUD_TIMEOUT_SECONDS=120
DOCSIFT_EVAL_CLOUD_INPUT_PRICE_PER_MILLION=0
DOCSIFT_EVAL_CLOUD_OUTPUT_PRICE_PER_MILLION=0

# Guardrails: логические проверки результата LLM
DOCSIFT_GUARDRAIL_CONFIDENCE_THRESHOLD=0.80
DOCSIFT_GUARDRAIL_DOCUMENT_MAX_AGE_DAYS=3650
DOCSIFT_GUARDRAIL_DOCUMENT_FUTURE_TOLERANCE_DAYS=1
